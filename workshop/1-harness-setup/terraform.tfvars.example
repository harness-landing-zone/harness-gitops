# Copy to terraform.tfvars (git-ignored) ONLY if you want to override defaults.
# HARNESS_ACCOUNT_ID and HARNESS_PLATFORM_API_KEY are read from the environment.

# github_org         = "harness-landing-zone"  # owner of your fork, if you use one
# org_id             = "gitops_reference"
# org_name           = "GitOps Reference Architecture"
# project_id         = "gitops_admin"
# project_name       = "GitOps Admin"
# environment_id     = "test"
# gitops_server_host = "https://app.harness.io/prod1/gitops"
# agent_http_target  = "https://app.harness.io/gitops"

# One Harness org per tenant (lowercase letters and digits only), one project
# per team. Changing these identifiers needs a fork matching tenants/<tenant>/.
# business_units = {
#   bu1 = {
#     name     = "Business Unit 1"
#     projects = { team_a = "Team A", team_b = "Team B" }
#   }
# }
