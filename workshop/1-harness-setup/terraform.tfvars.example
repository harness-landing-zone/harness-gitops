# Copy to terraform.tfvars (git-ignored) and fill in. Placeholders only.
account_id                 = "REPLACE_WITH_HARNESS_ACCOUNT_ID"
github_app_id              = "REPLACE_WITH_APP_ID"
github_app_installation_id = "REPLACE_WITH_INSTALLATION_ID"
github_app_private_key_file = "~/.ssh/REPLACE_github_app.pem"
